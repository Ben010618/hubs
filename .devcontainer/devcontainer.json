// Codespaces / Dev Containers setup for the classroom fork.
// Works now: install, lint, unit tests, production build, Storybook (build the Teacher HUD UI in isolation).
// Not yet: a full Hubs stack (Reticulum + Dialog) with voice. Codespaces only forwards HTTP(S), so WebRTC
// voice cannot be tested here. Phase 1 runs the full stack on our own server.
{
  "name": "hubs-classroom",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": { "minikube": "none" }
  },
  "postCreateCommand": "npm ci",
  "forwardPorts": [6006, 8080],
  "portsAttributes": {
    "6006": { "label": "Storybook", "onAutoForward": "openBrowser" },
    "8080": { "label": "Hubs client (webpack dev server)" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    },
    "codespaces": {
      "openFiles": ["src/classroom/README.md"]
    }
  }
}
